/* E-Lab 700 — dark theme: calm, uncluttered, generous rounding and spacing
   in the spirit of macOS System Settings rather than a dense technical
   panel. Segoe UI Variable (Windows 11's native UI font) is tried first —
   it reads closer to San Francisco than plain Segoe UI — with graceful
   fallbacks for Windows 7/10. */

* {
    font-family: "Segoe UI Variable Display", "Segoe UI Variable", "Segoe UI", "Helvetica Neue", sans-serif;
    color: #e6f7ff;
}

QMainWindow, QDialog {
    background-color: #05070a;
}

#TopStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #10192a, stop:1 #0a0f18);
    border-bottom: 1px solid #1c3a4a;
}

#microscopeInfoPanel {
    background-color: #0e1622;
    border: 1px solid #22384d;
    border-radius: 16px;
}

#microscopeInfoTitle {
    font-size: 16px;
    font-weight: 600;
    color: #5ce1e6;
}

#microscopeInfoSubtitle {
    font-size: 11px;
    color: #7c9bb5;
}

#microscopeInfoSection {
    font-size: 11px;
    font-weight: 600;
    color: #6b95b3;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#microscopeInfoLabel {
    font-size: 12px;
    color: #7c9bb5;
}

#microscopeInfoValue {
    font-size: 12px;
    font-weight: 600;
    color: #e6f7ff;
}

#microscopeInfoClose {
    background: transparent;
    border: none;
    color: #7c9bb5;
    font-weight: bold;
}

#microscopeInfoClose:hover {
    color: #ff5c6c;
}

#TopStatusBar QLabel {
    font-size: 13px;
    color: #8fb8d6;
}

#logoLabel {
    padding-right: 4px;
}

#connectionLabel {
    background: transparent;
    border: none;
    padding: 4px 10px;
    border-radius: 10px;
    font-size: 13px;
}

#connectionLabel:hover {
    background-color: #16202c;
}

#connectionLabel[connected="true"] {
    color: #35e08a;
    font-weight: 600;
}

#connectionLabel[connected="false"] {
    color: #ff5c6c;
    font-weight: 600;
}

#microscopeLabel {
    background: transparent;
    border: none;
    padding: 4px 12px;
    border-radius: 10px;
    color: #4d6a82;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
}

#microscopeLabel:hover {
    background-color: #16202c;
    color: #5ce1e6;
}

#resolutionLabel {
    background: transparent;
    border: none;
    padding: 4px 8px;
    border-radius: 10px;
    font-size: 13px;
    color: #8fb8d6;
}

#resolutionLabel:hover {
    background-color: #16202c;
    color: #5ce1e6;
}

#groupButton {
    background: transparent;
    border: 1px solid #22384d;
    border-radius: 16px;
    padding: 4px 16px;
    color: #5ce1e6;
    font-weight: 600;
    font-size: 13px;
}

#groupButton:hover {
    background-color: #16202c;
    border-color: #5ce1e6;
}

#teacherButton {
    background-color: transparent;
    border: 1px solid #22384d;
    border-radius: 18px;
    font-size: 16px;
    color: #4d6a82;
}

#teacherButton:hover {
    background-color: #16202c;
    border-color: #5ce1e6;
    color: #5ce1e6;
}

#quitButton {
    background-color: transparent;
    border: 1px solid #22384d;
    border-radius: 18px;
    font-size: 14px;
    color: #4d6a82;
}

#quitButton:hover {
    background-color: #3a1218;
    border-color: #ff5c6c;
    color: #ff5c6c;
}

#BottomBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0a0f18, stop:1 #10192a);
    border-top: 1px solid #1c3a4a;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #182636, stop:1 #101a26);
    border: 1px solid #274363;
    border-radius: 16px;
    padding: 7px 10px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #21384f, stop:1 #16283a);
    border-color: #5ce1e6;
    color: #eafeff;
}

QPushButton:pressed {
    background: #0d1620;
    border-color: #35e0e6;
}

#videoButton[recording="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4a1622, stop:1 #2c0f18);
    border-color: #ff5c6c;
    color: #ff8a94;
}

#zoomInButton, #zoomOutButton {
    border-radius: 22px;
    font-size: 18px;
}

#zoomLabel {
    background: transparent;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    color: #8fb8d6;
}

#zoomLabel:hover {
    background-color: #16202c;
    color: #5ce1e6;
}

/* Grouped "card" sections, closer to macOS System Settings than a plain
   bordered technical box: a soft-tinted fill instead of just an outline,
   generous rounding, and a small-caps muted title sitting slightly proud
   of the card rather than embedded in its border. */
QGroupBox {
    background-color: #0b111a;
    border: 1px solid #1c2e40;
    border-radius: 16px;
    margin-top: 18px;
    padding: 18px 16px 16px 16px;
    font-weight: 600;
    font-size: 12px;
    color: #6ee3e8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 2px;
    padding: 0 6px;
    letter-spacing: 0.5px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #1c2a3a;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2a8f95, stop:1 #5ce1e6);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #5ce1e6;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
    border: 2px solid #0a0f18;
}

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0a0f18;
    border: 1px solid #22384d;
    border-radius: 9px;
    padding: 5px 10px;
    color: #e6f7ff;
    selection-background-color: #2a5570;
}

QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #35526e;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #5ce1e6;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

/* Explicit sizing for the up/down arrows: once any QSS applies to a
   QAbstractSpinBox, Qt stops using the native button layout for its
   subcontrols too, and an unstated width could end up eating into the
   number's own display area rather than sitting cleanly beside it. */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 18px;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #0e1622;
    border: 1px solid #22384d;
    border-radius: 10px;
    color: #e6f7ff;
    selection-background-color: #1c3a4a;
    padding: 4px;
}

QMenu {
    background-color: #0e1622;
    border: 1px solid #22384d;
    border-radius: 12px;
    color: #e6f7ff;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 14px;
    border-radius: 8px;
    color: #e6f7ff;
}

QMenu::item:selected {
    background-color: #1c3a4a;
    color: #5ce1e6;
}

QMenu::item:disabled {
    color: #4d6a82;
}

QMenu::separator {
    height: 1px;
    background: #22384d;
    margin: 6px 10px;
}

QCheckBox {
    spacing: 10px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 1.5px solid #35526e;
    border-radius: 6px;
    background-color: #0a0f18;
}

QCheckBox::indicator:hover {
    border-color: #5ce1e6;
}

QCheckBox::indicator:checked {
    background-color: #35e0e6;
    border-color: #35e0e6;
}

QLabel {
    color: #cfe6f2;
}

QListWidget {
    background-color: #0a0f18;
    border: 1px solid #22384d;
    border-radius: 12px;
}

QListWidget::item {
    padding: 4px;
    border-radius: 8px;
}

QListWidget::item:selected {
    background-color: #1c3a4a;
    border-radius: 8px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QStatusBar {
    background-color: #0a0f18;
    color: #8fb8d6;
    border-top: 1px solid #1c3a4a;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #22384d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #5ce1e6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
